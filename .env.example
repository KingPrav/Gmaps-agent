# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env holds real secrets. Never commit it or share it.

# --- OpenAI (the "brain" of the agent) ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Which model the agent uses. A small, cheap model is plenty for this.
OPENAI_MODEL=gpt-4o-mini

# --- Google Maps (used by the MCP server) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# Enable "Places API (New)" for this key.
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# --- Your default location ---
# Used whenever you say "near me". Any address, neighborhood or city works.
MY_LOCATION=Jersey City, NJ
